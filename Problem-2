// Time complexity: O(n*l)
// Space complexity: O(n*l)

// Create a trie with a 26 sized array as children and a isEnd variable to know the end of a word
// Insert all words into the trie
// Do dfs from the root of the trie and check if a word can be constructed by checking isEnd at every character of the word
// Return the longest word

class Solution {
    class TrieNode {
        boolean isEnd;
        TrieNode[] children;

        public TrieNode() {
            this.children = new TrieNode[26];
        }
    }

    String result;
    TrieNode root;

    // Insert all word into the trie
    private void insert(String word) {
        TrieNode curr = root;
        for(int i = 0; i < word.length(); i++) {
            char ch = word.charAt(i);
            if(curr.children[ch-'a'] == null)
                curr.children[ch-'a'] = new TrieNode();
            curr = curr.children[ch-'a'];
        }
        curr.isEnd = true;
    }

    private void dfs(TrieNode node, StringBuilder sb) {
        // If the current string is longer update result string
        if(sb.length() > result.length())
            result = sb.toString();
        
        for(int i = 0; i < 26; i++) {
            // Check if it is a word in the dictionary using isEnd
            if(node.children[i] != null && node.children[i].isEnd) {
                sb.append((char)(i+'a'));
                dfs(node.children[i], sb);
                sb.deleteCharAt(sb.length()-1);
            }
        }
    }

    public String longestWord(String[] words) {
        this.root = new TrieNode();
        this.result = "";
        // Insert all words to the trie
        for(String word : words) {
            insert(word);
        }
    
        dfs(root, new StringBuilder());
    
        return result;
    }
}